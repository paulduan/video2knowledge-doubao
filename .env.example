# 全局火山密钥
VOLC_ACCESS_KEY=你的AccessKeyID
VOLC_SECRET_KEY=你的AccessKeySecret

# TOS 对象存储（上传音频用）
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_BUCKET=你的桶名称
TOS_REGION=cn-beijing

# 豆包语音 ASR（录音文件识别）
# ASR_RESOURCE_ID: 1.0 为 volc.bigasr.auc；若控制台开通 2.0，改 volc.seedasr.auc
ASR_X_API_KEY=你的ASR_API_Key
ASR_RESOURCE_ID=volc.bigasr.auc

# 火山方舟 — 视觉模型（OCR/画面描述）doubao-seed-2-1-pro
ARK_API_KEY=sk-xxxxxxxx
ARK_EP_ID=ep-20260815105723-wdlb8
# 可选: 方舟 API base URL（OCR 用 Responses API，默认 https://ark.cn-beijing.volces.com/api/v3）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 可选: 纯文本模型接入点（知识生成用，不设则复用视觉模型）
# ARK_TEXT_EP_ID=ep-yyyyyy
